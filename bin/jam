#!/usr/bin/env bash
# jam — the clone step, and nothing else.
#
# There is deliberately no publish wrapper here. Recording a run is `cockpit publish`, which also
# RUNS it, in the image this repository pins, and commits and pushes what came out. One action.
#
#   jam new <slug> --from <example>   a run folder with the inputs copied in
#   jam runs                          the run folders on disk
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"
die() { echo "jam: $*" >&2; exit 1; }

cmd_new() {
  local slug="${1:-}"; shift || true
  [ -n "$slug" ] || die "usage: jam new <slug> --from <example>"
  local ex=""
  while [ $# -gt 0 ]; do
    case "$1" in --from) ex="${2:-}"; shift 2;; *) die "unknown option $1";; esac
  done
  [ -n "$ex" ] || die "jam new needs --from <example>"
  [ -d "examples/$ex" ] || die "no examples/$ex"
  local dir="runs/$slug"
  [ -e "$dir" ] && die "$dir exists — pick another slug"

  mkdir -p "$dir/inputs" "$dir/out"
  local n=0 f
  for f in $(sed -n 's/^# *INPUT: *//p' "examples/$ex/TASK.md"); do
    [ -f "$f" ] || die "$f is missing"
    cp "$f" "$dir/inputs/$(basename "$f")"; n=$((n+1))
  done
  [ "$n" -gt 0 ] || die "examples/$ex/TASK.md declares no '# INPUT:' lines"
  cp "examples/$ex/starter.R" "$dir/analysis.R"
  printf '# %s\n\nFrom: %s\nStarted: %s\n\n## What I am trying\n\n\n' \
    "$slug" "$ex" "$(date -u +%Y-%m-%dT%H:%MZ)" > "$dir/RUN.md"

  printf '\n== runs/%s ==\n' "$slug"
  printf '  inputs/   %d file(s), copied — the exact bytes\n' "$n"
  printf '  analysis.R  yours\n  out/      whatever your script writes\n\n'
  printf '  edit it, then run AND record it in one go:\n\n'
  printf "    ./bin/cockpit publish '{\"cmd\":\"Rscript runs/%s/analysis.R\",\n" "$slug"
  printf '       "inputs":["runs/%s/analysis.R","runs/%s/inputs/%s"],\n' "$slug" "$slug" "$(basename "$(ls "$dir/inputs" | head -1)")"
  printf '       "outputs":["runs/%s/out/<what-your-script-writes>"]}'"'"'\n\n' "$slug"
}

cmd_runs() {
  printf '\n== run folders on disk ==\n'
  local any=0
  for d in runs/*/; do
    [ -d "$d" ] || continue; any=1
    printf '  %-24s %s output(s)\n' "$(basename "$d")" "$(ls "$d/out" 2>/dev/null | wc -l)"
  done
  [ "$any" = 1 ] || printf '  none yet\n'
  printf '\n  This lists DIRECTORIES. It knows nothing about what was recorded, by whom, or from\n'
  printf '  what. For that, ask the cockpit — and if you cannot get the answer you want out of it,\n'
  printf '  that is the thing worth writing down.\n\n'
}

case "${1:-}" in
  new)  shift; cmd_new "$@";;
  runs) shift; cmd_runs "$@";;
  *) sed -n '3,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2;;
esac
