#!/usr/bin/env bash
# bin/setup <your-name> — join this repository as yourself.
#
# Everyone works in the SAME repository. What differs per person is exactly one thing: which key
# signs your records. So the shared half of the configuration is committed
# (cockpit.config.shared.json) and the half that names you is written here and never committed.
#
# Safe to re-run. Re-run it after pulling, to pick up teammates' public keys.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

ME="${1:-}"
[ -n "$ME" ] || { echo "usage: bin/setup <your-name>   (e.g. bin/setup alice)" >&2; exit 1; }
case "$ME" in *[!a-z0-9-]*) echo "keep it to lowercase letters, digits and dashes" >&2; exit 1;; esac

COCKPIT_SRC="${COCKPIT_SRC:-$(dirname "$REPO")/kton-cockpit}"
KTON_SRC="${KTON_SRC:-$(dirname "$REPO")/kton-pinned}"

echo "== binaries =="
mkdir -p bin
[ -x bin/cockpit ]  || (cd "$COCKPIT_SRC" && go build -o "$REPO/bin/cockpit" ./cmd/cockpit)
[ -x bin/plankton ] || (cd "$KTON_SRC" && go build -o "$REPO/bin/plankton" ./reference/cmd/plankton)
[ -x bin/nekton ]   || (cd "$KTON_SRC" && go build -o "$REPO/bin/nekton"   ./nekton/reference/cmd/nekton)
echo "  $(./bin/cockpit version | head -1)"

echo "== your identity =="
mkdir -p keys registry/plankton registry/nekton registry/keys runs work
if [ ! -f "keys/$ME.key" ]; then
  ./bin/plankton keygen "keys/$ME"        >/dev/null
  ./bin/nekton   keygen "keys/$ME-claims" >/dev/null
  cp "keys/$ME.pub" "keys/$ME-claims.pub" registry/keys/
  echo "  new key for $ME — keys/$ME.key is PRIVATE and is not committed"
else
  echo "  keys/$ME.key already exists, keeping it"
fi

echo "== configuration =="
ORIGIN="$(git remote get-url origin)"
OWNER_REPO="${ORIGIN#*github.com}"; OWNER_REPO="${OWNER_REPO#[:/]}"; OWNER_REPO="${OWNER_REPO%.git}"
python3 - "$ME" "${OWNER_REPO%%/*}" "${OWNER_REPO##*/}" <<'PY'
import glob, json, os, sys
me, owner, name = sys.argv[1:4]
cfg = json.load(open("cockpit.config.shared.json"))
cfg["repo"] = {"owner": owner, "name": name}
cfg["identity"] = {"session_id": me,
                   "plankton_key": f"keys/{me}.key",
                   "nekton_key":   f"keys/{me}-claims.key"}
# Everyone who has pushed a public key is in the team tier. Re-running setup after a pull is how
# you start being able to verify a teammate who joined after you did.
mine = sorted(p for p in glob.glob("registry/keys/*.pub") if os.path.basename(p).startswith(me + "."))
mine += sorted(p for p in glob.glob("registry/keys/*.pub") if os.path.basename(p).startswith(me + "-claims."))
team = sorted(set(glob.glob("registry/keys/*.pub")) - set(mine))
cfg["trust"] = {"tiers": {"self": mine, "team": team}}
json.dump(cfg, open("cockpit.config.json", "w"), indent=2)
print(f"  you are '{me}'; {len(team)} teammate key(s) trusted")
PY
./bin/cockpit doctor | grep -E "bound to|trust tiers|execution|git:" | sed 's/^/  /'
echo ""
echo "Next:  bin/jam new ${ME}-1 --from fog"
