#!/usr/bin/env bash
# bin/setup <your-name> — join this repository as yourself.
#
# Everyone works in the SAME repository. What differs per person is exactly one thing: which key
# signs your records. So the shared half of the configuration is committed
# (cockpit.config.shared.json) and the half that names you is written here and never committed.
#
# Safe to re-run. Re-run it after pulling, to pick up teammates' public keys.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

ME="${1:-}"
[ -n "$ME" ] || { echo "usage: bin/setup <your-name>   (e.g. bin/setup alice)" >&2; exit 1; }
case "$ME" in *[!a-z0-9-]*) echo "keep it to lowercase letters, digits and dashes" >&2; exit 1;; esac

# One binary. The kernels are linked into it, so there is nothing else to install.
if [ ! -x bin/cockpit ]; then
  SRC="${COCKPIT_SRC:-$(dirname "$REPO")/kton-cockpit}"
  [ -d "$SRC" ] || { echo "no kton-cockpit checkout at $SRC (set COCKPIT_SRC)" >&2; exit 1; }
  (cd "$SRC" && go build -o "$REPO/bin/cockpit" ./cmd/cockpit)
fi
echo "$(./bin/cockpit version | head -1)"

mkdir -p keys registry/plankton registry/nekton registry/keys runs
./bin/cockpit keygen "$ME"
cp "keys/$ME.pub" "keys/$ME-claims.pub" registry/keys/

ORIGIN="$(git remote get-url origin)"
OWNER_REPO="${ORIGIN#*github.com}"; OWNER_REPO="${OWNER_REPO#[:/]}"; OWNER_REPO="${OWNER_REPO%.git}"
python3 - "$ME" "${OWNER_REPO%%/*}" "${OWNER_REPO##*/}" <<'PY'
import glob, json, os, sys
me, owner, name = sys.argv[1:4]
cfg = json.load(open("cockpit.config.shared.json"))
cfg["repo"] = {"owner": owner, "name": name}
cfg["identity"] = {"session_id": me,
                   "plankton_key": f"keys/{me}.key", "nekton_key": f"keys/{me}-claims.key"}
mine = sorted(p for p in glob.glob("registry/keys/*.pub")
              if os.path.basename(p).split(".")[0].split("-claims")[0] == me)
team = sorted(set(glob.glob("registry/keys/*.pub")) - set(mine))
cfg["trust"] = {"tiers": {"self": mine, "team": team}}
json.dump(cfg, open("cockpit.config.json", "w"), indent=2)
print(f"you are '{me}'; {len(team)} teammate key(s) trusted")
PY

# Your public key has to reach the others or nothing you sign verifies for them. Doing it here
# rather than telling you to: a first run of this test spent an hour with three byte-identical
# results reporting "1 verified signer, 2 excluded" because nobody had pushed a .pub file.
git add registry/keys
if ! git diff --cached --quiet; then
  git -c user.name="$ME" -c user.email="$ME@cockpit.local" commit -qm "keys: $ME joins"
  git pull -q --rebase && git push -q
  echo "your public key is pushed — teammates will trust you after their next bin/setup"
fi

./bin/cockpit doctor | grep -E "bound to|trust tiers|execution" | sed 's/^/  /'
echo ""
echo "Next:  ./bin/cockpit run new ${ME}-1 --from examples/fog"
